# Copy this file to .env and adjust. Never commit .env.

# development | test | production
ENVIRONMENT=development

# dev  = pick a demo user from a dropdown in the UI; no Keycloak needed.
#        Lets everyone build features before SSO is finished. Refused when ENVIRONMENT=production.
# oidc = real single sign-on through Keycloak (cards M1-05, M1-06, M1-07).
AUTH_MODE=dev

# API log level (card M1-03): DEBUG | INFO | WARNING | ERROR. Logs are JSON lines on stdout.
LOG_LEVEL=INFO

# Database (cards M1-04, M2-01)
POSTGRES_USER=capybara
POSTGRES_PASSWORD=capybara
POSTGRES_DB=capybara
DATABASE_URL=postgresql+psycopg://capybara:capybara@db:5432/capybara
# The port the database is published on, on your own machine. Change it (e.g. to 5433) if
# you already run PostgreSQL locally. Tests and tools run outside Docker connect here.
POSTGRES_HOST_PORT=5432
# Tests create and drop their own database, capybara_test, on that port. Override only if
# your test database is elsewhere; the name must end in _test.
# TEST_DATABASE_URL=postgresql+psycopg://capybara:capybara@localhost:5432/capybara_test

# Keycloak (cards M1-05, M1-06)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# The issuer is the browser's address, not idp:8080; see KC_HOSTNAME in docker-compose.yml.
OIDC_ISSUER=http://localhost:8080/realms/capybara
OIDC_AUDIENCE=capybara-api
# Where the API fetches Keycloak's signing keys. Inside Docker this is idp:8080, not the
# issuer's localhost:8080 (which is the api container itself). Running the API outside
# Docker, use http://localhost:8080/realms/capybara/protocol/openid-connect/certs.
OIDC_JWKS_URL=http://idp:8080/realms/capybara/protocol/openid-connect/certs

# LLM: stub until the team picks a provider (card M3-02). Put the real key here, never in code.
LLM_PROVIDER=stub
# LLM_API_KEY=

# Discord (cards M4-06, M4-09)
# DISCORD_BOT_TOKEN=
