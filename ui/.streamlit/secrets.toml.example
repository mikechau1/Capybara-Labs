# Needed only for AUTH_MODE=oidc. Copy to secrets.toml (never commit it). Card M1-07.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "capybara-ui"
client_secret = "replace-with-the-keycloak-client-secret"
server_metadata_url = "http://localhost:8080/realms/capybara/.well-known/openid-configuration"
expose_tokens = "access"
