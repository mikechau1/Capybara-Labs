# Login settings for AUTH_MODE=oidc (card M1-07). Not needed in dev mode.
#
# 1. Copy this file to secrets.toml in the same folder. It is gitignored; never commit it.
# 2. Replace cookie_secret with a random value:
#      python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Restart the ui service: docker compose up -d ui (the folder is mounted; no rebuild).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "capybara-ui"
# The realm's dev-only secret (infra/keycloak/capybara-realm.json). Change it before deploying.
client_secret = "capybara-ui-dev-secret"
# Fetched by the ui server, not the browser, so inside Docker Keycloak is idp:8080. Running
# Streamlit outside Docker, use http://localhost:8080/realms/capybara/.well-known/openid-configuration
server_metadata_url = "http://idp:8080/realms/capybara/.well-known/openid-configuration"
# Puts the access token in st.user.tokens, which the UI sends to the API as a bearer token.
expose_tokens = "access"
