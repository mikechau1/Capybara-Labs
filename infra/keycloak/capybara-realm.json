      { "name": "manager", "description": "Department manager" },
      { "name": "owner", "description": "Department owner: manages grants and access requests" },
      { "name": "app-admin", "description": "Runs the system. Gives no data access by itself" }
    ]
  },
  "groups": [
    { "name": "engineering" },
    { "name": "finance" }
  ],
